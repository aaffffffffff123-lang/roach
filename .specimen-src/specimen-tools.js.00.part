  const g=new THREE.Group(),metal=matMetal(),wood=matPlastic(0x7a3e20);const spike=cyl(.004,.018,.54,metal,0,0,.27,10);spike.rotation.x=Math.PI/2;g.add(spike);const ferrule=cyl(.03,.025,.11,metal,0,0,.60,12);ferrule.rota