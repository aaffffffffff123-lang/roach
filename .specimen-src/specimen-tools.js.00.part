import {THREE,clamp,lerp,rand,smooth} from './specimen-core.js';

export const TOOL_LABELS={
  pin:'핀',tweezer:'족집게',clipper:'손톱깎이',awl:'송곳',cutter:'커터',lighter:'목 긴 라이터',piezo:'압전 딱딱이'
};
