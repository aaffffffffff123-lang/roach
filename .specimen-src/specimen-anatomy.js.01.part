      {tag:'M',name:'가운데',z:.04,yawR:-.02,yawL:Math.PI+.02,lens:[.17,.09,.48,.56,.14,.11,.09,.075,.062]},
      {tag:'H',name:'뒤',z:-.30,yawR:.52,yawL:Math.PI-.52,lens:[.18,.10,.59,.69,.17,.13,.105,.086,.07]}
